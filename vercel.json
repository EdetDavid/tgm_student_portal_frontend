{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://tgm-student-portal-backend.vercel.app/api/$1" },
    { "source": "/static/rest_framework/(.*)", "destination": "https://tgm-student-portal-backend.vercel.app/static/rest_framework/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" }
  ]
}
