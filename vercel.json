{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tgm-student-portal-backend.vercel.app/api/:path*" },
    { "source": "/static/rest_framework/:path*", "destination": "https://tgm-student-portal-backend.vercel.app/static/rest_framework/:path*" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
